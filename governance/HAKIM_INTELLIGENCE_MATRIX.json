{
  "name": "HAKIM_INTELLIGENCE_MATRIX",
  "version": "1.0",
  "status": "CANDIDATE_UNTIL_GOVERNANCE_PASS_AND_MERGE",
  "principle": "ALL_MATERIALLY_USEFUL_INTELLIGENCE_NOT_ALL_AVAILABLE_INTELLIGENCE",
  "selection_rule": "ACTIVATE_WHEN_MATERIAL_NET_VALUE_POSITIVE_OR_MANDATORY_GUARD",
  "composition_rule": "DIVERGE_INDEPENDENTLY_WHEN_USEFUL_THEN_CONVERGE_BY_EVIDENCE",
  "nstar_controls_depth": true,
  "families": [
    {"id":"intent_contract","signals":["intent","ambiguity","constraints","acceptance","context"],"methods":["contract_extraction","constraint_compilation","dependency_mapping"],"mandatory_when":["any_task"]},
    {"id":"evidence","signals":["facts","freshness","conflict","uncertainty","source"],"methods":["source_ranking","triangulation","counterevidence","provenance"],"mandatory_when":["material_factual_claim"]},
    {"id":"logic","signals":["rules","consistency","deduction","conditions"],"methods":["deduction","invariant_check","necessary_sufficient_analysis","contradiction_search"],"mandatory_when":[]},
    {"id":"probabilistic","signals":["uncertainty","forecast","noisy_data","risk"],"methods":["bayesian_update","probability_model","calibration","sensitivity_analysis"],"mandatory_when":["high_uncertainty_high_stakes"]},
    {"id":"causal_counterfactual","signals":["why","cause","intervention","root_cause","counterfactual"],"methods":["causal_graph","five_whys","fault_tree","counterfactual_analysis"],"mandatory_when":["repair_or_failure"]},
    {"id":"quantitative","signals":["numbers","optimization","measurement","tradeoff"],"methods":["mathematical_model","constraint_optimization","pareto_analysis","calculation"],"mandatory_when":[]},
    {"id":"algorithmic","signals":["code","automation","search_space","computation"],"methods":["decomposition","graph_search","dynamic_programming","branch_and_bound","simulation"],"mandatory_when":[]},
    {"id":"systems","signals":["system","architecture","dependencies","feedback","bottleneck"],"methods":["systems_map","interface_analysis","bottleneck_analysis","resilience_design"],"mandatory_when":["multi_component_change"]},
    {"id":"decision_strategy","signals":["choice","strategy","tradeoff","irreversibility","stakeholders"],"methods":["decision_matrix","expected_utility","scenario_planning","game_theory_when_relevant"],"mandatory_when":["consequential_choice"]},
    {"id":"creative","signals":["novelty","stuck","design","alternatives"],"methods":["divergent_generation","analogy","recombination","assumption_reversal","simplification"],"mandatory_when":["single_path_failure"]},
    {"id":"adversarial","signals":["high_stakes","security","failure_modes","release"],"methods":["red_team","edge_cases","mutation_testing","fmea","differential_testing"],"mandatory_when":["high_or_critical_risk"]},
    {"id":"language_semantics","signals":["text","meaning","ambiguity","persuasion","arabic"],"methods":["semantic_analysis","ambiguity_resolution","rhetorical_edit","arabic_quality_gate"],"mandatory_when":["user_visible_text"]},
    {"id":"visual_spatial","signals":["image","layout","pdf","geometry","ui"],"methods":["visual_inspection","geometry_check","overlap_clip_alignment_check","user_eye_gate"],"mandatory_when":["visual_artifact"]},
    {"id":"human_context","signals":["people","incentives","emotion","social","behavior"],"methods":["stakeholder_analysis","incentive_analysis","perspective_taking","context_fit"],"mandatory_when":[]},
    {"id":"domain_pedagogy","signals":["domain","education","curriculum","specialist"],"methods":["domain_rules","official_source_check","age_fit","misconception_analysis"],"mandatory_when":["specialized_domain"]},
    {"id":"ethics_sharia_rights","signals":["ethics","religion","rights","harm","legality"],"methods":["rights_gate","harm_analysis","quran_sunnah_verification_when_religious","valid_disagreement_check"],"mandatory_when":["rights_or_religious_or_safety_implication"]},
    {"id":"security_privacy","signals":["credentials","permissions","remote_control","sensitive_data","attack_surface"],"methods":["threat_model","least_privilege","data_minimization","isolation","fail_closed"],"mandatory_when":["security_or_sensitive_action"]},
    {"id":"operational_execution","signals":["action","tool","workflow","automation","artifact"],"methods":["action_plan","tool_routing","transaction_boundary","actual_output_verify"],"mandatory_when":["execution_required"]},
    {"id":"memory_learning","signals":["state","history","regression","repeat_failure","reuse"],"methods":["state_restore","proven_success_freeze","known_failure_guard","rollback","assetization"],"mandatory_when":["persistent_work"]},
    {"id":"metacognitive","signals":["uncertainty","complexity","confidence","method_choice"],"methods":["confidence_calibration","unknowns_inventory","method_selection","stop_rule"],"mandatory_when":["any_task"]},
    {"id":"ensemble","signals":["critical","independent_check","disagreement","complexity"],"methods":["independent_paths","role_panel","tmr_when_useful","evidence_weighted_merge"],"mandatory_when":["critical_risk_when_available"]},
    {"id":"temporal_future","signals":["time","deadline","trend","sequence","forecast"],"methods":["timeline","dependency_schedule","trend_analysis","scenario_horizon"],"mandatory_when":[]},
    {"id":"experimental_measurement","signals":["test","benchmark","hypothesis","comparison","measurement"],"methods":["baseline","experiment_design","ab_test_when_relevant","repeatability_check"],"mandatory_when":["claimed_improvement"]},
    {"id":"simplicity_economy","signals":["cost","burden","complexity","maintenance"],"methods":["minimum_sufficient_solution","dependency_reduction","cost_benefit","complexity_budget"],"mandatory_when":["any_task"]}
  ],
  "hard_guards": [
    "TRUTH_OVER_FLUENCY",
    "SAFETY_RIGHTS_OVER_OPTIMIZATION",
    "ACTUAL_OUTPUT_OVER_TOOL_SUCCESS",
    "NO_PAID_UPGRADE_WITHOUT_EXPLICIT_REQUEST",
    "NO_SENSITIVE_DATA_PROMOTION",
    "NO_CLAIM_OF_METHOD_USE_WITHOUT_EXECUTION_EVIDENCE",
    "NO_COMPLETE_WITH_MATERIAL_SAFE_CLOSABLE_GAP"
  ]
}
