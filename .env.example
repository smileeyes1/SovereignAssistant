# Required repository and webhook/runtime credentials
OMEGA_REPOSITORY=owner/repository
OMEGA_GITHUB_TOKEN=replace-with-fine-grained-token
OMEGA_GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
OMEGA_RUNTIME_TOKEN=replace-with-random-runtime-token

# Service and durable state
OMEGA_HOST=0.0.0.0
OMEGA_PORT=8080
OMEGA_DB_PATH=/data/omega.db
OMEGA_WORKER_ID=omega-worker-1

# Write gates: conservative defaults remain fail-closed
OMEGA_ALLOW_BRANCH_CREATE=true
OMEGA_ALLOW_COMMENT=true
OMEGA_ALLOW_MERGE=false
OMEGA_ALLOW_FILE_WRITE=false

# Ω FREE-FIRST COST POLICY — authoritative defaults
# Paid providers stay disabled even if a paid API key is present.
OMEGA_PAID_PROVIDERS_ALLOWED=false
OMEGA_PAID_PROVIDER_MAX_CALLS=0
OMEGA_PROVIDER_FAILURE_LOG_CHAR_BUDGET=8000
OMEGA_PROVIDER_MAX_OUTPUT_TOKENS=3072

# First choice: local/offline OpenAI-compatible model (zero marginal API cost).
# Example local endpoint shape: http://127.0.0.1:11434/v1
OMEGA_LOCAL_API_BASE_URL=http://127.0.0.1:11434/v1
OMEGA_LOCAL_MODEL=
OMEGA_LOCAL_API_KEY=

# Second choice: user-selected zero-cost/free-tier OpenAI-compatible endpoint.
# The project deliberately does not hard-code a vendor because free tiers change.
OMEGA_FREE_API_BASE_URL=
OMEGA_FREE_MODEL=
OMEGA_FREE_API_KEY=

# Paid break-glass route only. It is inert unless BOTH paid-policy variables above
# explicitly allow it with a positive finite call budget.
OMEGA_OPENAI_API_KEY=
OMEGA_OPENAI_MODEL=
OMEGA_OPENAI_BASE_URL=https://api.openai.com/v1
