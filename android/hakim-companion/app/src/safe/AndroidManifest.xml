<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Safe-install surface: browser + network only. Remove capabilities that triggered the field warning. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <application>
        <activity android:name=".MainActivity" tools:node="remove" />

        <activity
            android:name=".SafeMainActivity"
            android:exported="true"
            android:label="حكيم">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".HakimForegroundService" tools:node="remove" />
        <service android:name=".HakimAccessibilityService" tools:node="remove" />
        <service android:name=".HakimNotificationListener" tools:node="remove" />

        <receiver android:name=".HakimPairingReceiver" tools:node="remove" />
        <receiver android:name=".RemoteApprovalReceiver" tools:node="remove" />
        <receiver android:name=".DirectApprovalReceiver" tools:node="remove" />
        <receiver android:name=".FinancialSafeModeReceiver" tools:node="remove" />
        <receiver android:name=".BootReceiver" tools:node="remove" />
    </application>
</manifest>
